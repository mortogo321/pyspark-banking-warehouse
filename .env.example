# Copy to .env and adjust if needed. Every value here has a non-secret
# default baked into src/pipeline/config.py and docker-compose.yml, so
# running without a .env file at all also works.

# --- LocalStack S3 (stands in for real S3) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=lake

# --- Postgres (stands in for Redshift) ---
POSTGRES_DB=warehouse
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=warehouse

# --- Business rules ---
CTR_THRESHOLD=2000000

# --- Synthetic data generation (deterministic; change the seed for a
#     different-but-still-reproducible dataset) ---
RANDOM_SEED=42
NUM_CUSTOMERS=2000
NUM_ACCOUNTS=3000
NUM_TRANSACTIONS=60000
DATA_END_DATE=2026-06-30
DATA_WINDOW_DAYS=90
